# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# On Vercel, use VITE_GEMINI_API_KEY to expose it to the frontend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (Supabase recommended)
# 1. Go to Supabase Dashboard > Project Settings > Database
# 2. Under "Connection string", select "URI"
# 3. Use the "Transaction" mode string (port 6543)
# 4. Copy the EXACT string from your dashboard. Do NOT guess the host or region.
#    It will look similar to: postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres
# 5. Replace [PASSWORD] with your actual DB password.
# 6. Ensure the host (e.g. aws-0-us-east-1) matches your project's region exactly.
DATABASE_URL=
